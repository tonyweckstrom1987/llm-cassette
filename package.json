{
  "name": "llm-cassette",
  "version": "0.1.0",
  "description": "Tallenna LLM-kutsujen vastaukset kerran ja toista ne testeissä: nopeat, ilmaiset ja vakaat testit ilman verkkoa. Record/replay for fetch-based LLM clients.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
